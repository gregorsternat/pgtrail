# Local development only. These are disposable example credentials, not secrets.
# Docker Compose reads .env automatically; pgtrail does not load it.
# Configure PGTRAIL_DATABASE_URL or profile password variables in your shell.
# Use a separate COMPOSE_PROJECT_NAME and port for each PostgreSQL major.
PGTRAIL_POSTGRES_VERSION=18
PGTRAIL_POSTGRES_PORT=55432
PGTRAIL_ADMIN_PASSWORD=pgtrail-local-admin
PGTRAIL_MONITOR_PASSWORD=pgtrail-local-monitor
